{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker name in the Cloudflare dashboard.
  "name": "cluedo-game",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  // Build the site before every deploy, so `npx wrangler deploy` works on its own.
  // In `wrangler dev`, edits to the server code (and the shared engine) reload the Worker.
  "build": {
    "command": "npm run build",
    "watch_dir": ["worker", "src/game"]
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "GameRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom"] }],
  "observability": { "enabled": true }
}
